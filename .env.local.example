# Copy this file to .env.local for local development.
# In production, set the same variables in Vercel → Project Settings → Environment Variables.

# Admin login (choose your own values — this is a single shared admin account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-strong
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Vercel Blob (photo storage) — created automatically when you connect a
# Blob store to this project in the Vercel dashboard (Storage tab). Vercel
# injects this automatically in production; for local dev, copy the value
# from Vercel → Storage → your Blob store → ".env.local" tab.
BLOB_READ_WRITE_TOKEN=
